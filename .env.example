# ==============================================================================
# Polaris - Vercel Environment Variables Configuration
# ==============================================================================

# --- Supabase (Database & Auth) ---
# Automatically populated if connected via the Vercel Supabase Integration,
# or retrieve from Supabase Dashboard -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# (Optional) Service role key for admin actions / cron ingestion
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Map Provider (100% Self-Hosted & GDPR / § 35 SGB I Compliant on Cloudflare R2) ---
# Cloudflare R2 bucket with $0 egress fees and edge caching. Set to your bucket or custom domain URL:
NEXT_PUBLIC_PMTILES_URL=https://pub-f3f0eb63a5f147d589065f16773925a3.r2.dev/germany.pmtiles

# --- AI & Vercel AI Gateway ---
# AI_API_KEY is your model provider API key (DeepSeek, OpenAI, Groq, etc.)
AI_API_KEY=your-ai-api-key
# AI_BASE_URL (defaults to https://api.deepseek.com if unset)
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# (Optional) Vercel AI Gateway endpoint:
VERCEL_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/...

# --- Search & External Services ---
EXA_API_KEY=your-exa-api-key

# --- Admin & Background Automation ---
# Used to authenticate /api/admin/ingest. Vercel Cron automatically passes CRON_SECRET.
INGESTION_SECRET=your-secret-token
CRON_SECRET=your-cron-secret-token

# --- Notion Sync (Optional / Scripts) ---
NOTION_API_KEY=your-notion-key
NOTION_DATABASE_ID=your-notion-db-id

# --- Stripe Billing & Subscriptions ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID=prod_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_EXTRA_SEAT_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

